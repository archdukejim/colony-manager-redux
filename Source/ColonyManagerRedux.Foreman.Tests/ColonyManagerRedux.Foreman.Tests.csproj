<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseLaboratory>true</UseLaboratory>
        <RootNamespace>ColonyManagerRedux.Foreman.Tests</RootNamespace>
        <AssemblyName>ColonyManagerRedux.Foreman.Tests</AssemblyName>
    </PropertyGroup>

    <!-- CS0436: harmless IgnoresAccessChecksTo shadow when RimTestRedux is excluded (non-1.6). -->
    <PropertyGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>

    <!--
        Dev-only test assembly, built and run in-game via RimTest Redux (https://github.com/ilyvion/rimtest-redux).
        Listed in ColonyManagerRedux.sln so it always builds in Debug, but the sln deliberately OMITS a
        Release|Any CPU.Build.0 line for this project's GUID, so Release builds (CI/release) skip it entirely.
        RimTest Redux only supports RimWorld 1.6, so for any other RimWorldVersion this builds as an empty
        assembly: both the test sources and the RimTestRedux reference are excluded below.
    -->
    <ItemGroup>
        <ProjectReference Include="..\ColonyManagerRedux.Foreman\ColonyManagerRedux.Foreman.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
        <ProjectReference Include="$(ProjectDependenciesBasePath)\RimTest\Source\RimTestRedux\RimTestRedux.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <Compile Remove="**/*.cs" />
    </ItemGroup>
</Project>
